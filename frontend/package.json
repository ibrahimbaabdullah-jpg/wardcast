{
  "name": "wardcast-frontend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.json *.yaml index.html",
    "format:check": "prettier --check src tests scripts *.ts *.json *.yaml index.html",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
